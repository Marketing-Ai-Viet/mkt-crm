# ========== Order Overdue Delayed Job Configuration ==========
# Delay in milliseconds before order becomes OVERDUE (default: 86400000 = 24 hours)
# Minimum: 3600000 (1 hour)
MKT_ORDER_OVERDUE_DELAY_MS=86400000

# Max retry attempts when job fails (default: 3)
MKT_ORDER_OVERDUE_RETRY_ATTEMPTS=3

# Base backoff delay in ms for exponential retry (default: 60000 = 1 minute)
MKT_ORDER_OVERDUE_BACKOFF_MS=60000

# Worker concurrency - số jobs xử lý đồng thời (default: 5)
MKT_ORDER_OVERDUE_WORKER_CONCURRENCY=5

SEPAY_IP_WHITELIST_ENABLED=true  # Enable/disable (default: false)
