# ———————— RBAC Configuration ————————
# RBAC Validation Mode
# - SIMPLIFIED: 6-step validation (fast, CRUD-only - for basic module + action permissions)
# - FULL: 15-step validation (complete, enterprise-grade with all advanced features)
RBAC_VALIDATION_MODE=SIMPLIFIED


# ========== OAuth2 Client Configuration ==========
# Base URL của Authorization Server (MKT Core)
MKT_API_BASE_URL=http://localhost:3006

# Client credentials từ Authorization Server
MKT_OAUTH_CLIENT_ID=019bd5b2-de45-7780-b773-e5f702f48aec
MKT_OAUTH_CLIENT_SECRET=KD-4-JQ46lf-vYI2KMTznLVOApIdTMbdRFD_GzD-6es

# Scopes cần request (space-separated)
MKT_OAUTH_SCOPES=products:manage,products:write,products:read,product-packages:read,product-packages:write,product-packages:manage,licenses:read,licenses:write,licenses:manage,users:read,users:write,users:manage

# OAuth2 Endpoints
OAUTH2_TOKEN_ENDPOINT=/oauth/token
OAUTH2_INTROSPECT_ENDPOINT=/oauth/introspect
OAUTH2_REVOKE_ENDPOINT=/oauth/revoke

# Cache Configuration
OAUTH2_CACHE_LRU_MAX=10
OAUTH2_CACHE_LRU_TTL_MS=3600000
OAUTH2_CACHE_REDIS_TTL_SECONDS=3600

# Token Refresh Configuration
OAUTH2_REFRESH_THRESHOLD_SECONDS=300
OAUTH2_REFRESH_INTERVAL_MS=30000

# HTTP Configuration
OAUTH2_HTTP_TIMEOUT_MS=10000
OAUTH2_HTTP_MAX_RETRIES=3
OAUTH2_HTTP_RETRY_DELAY_MS=1000

# Rate Limiting
OAUTH2_RATE_LIMIT_ENABLED=true
OAUTH2_RATE_LIMIT_MAX_ATTEMPTS=10
OAUTH2_RATE_LIMIT_WINDOW_MS=60000

# Circuit Breaker
OAUTH2_CIRCUIT_BREAKER_ENABLED=true
OAUTH2_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
OAUTH2_CIRCUIT_BREAKER_RESET_TIMEOUT_MS=60000
OAUTH2_CIRCUIT_BREAKER_HALF_OPEN_ATTEMPTS=3

# JWT Verification (Optional)
OAUTH2_JWT_VERIFICATION_ENABLED=false
OAUTH2_JWT_ALGORITHM=RS256

# Redis Health Check
OAUTH2_REDIS_HEALTH_CHECK_ENABLED=true
OAUTH2_REDIS_HEALTH_CHECK_INTERVAL_MS=30000
OAUTH2_REDIS_HEALTH_CHECK_TIMEOUT_MS=5000
OAUTH2_REDIS_HEALTH_CHECK_UNHEALTHY_THRESHOLD=3

# ========== MKT Product Sync Configuration ==========
# Enable auto-sync products when OAuth2 token is acquired (default: true)
MKT_AUTO_SYNC_ENABLED=true

# Sync products on startup after initial token acquisition (default: true)
MKT_SYNC_ON_STARTUP=true

# Batch size for pagination when syncing products (default: 50)
MKT_SYNC_BATCH_SIZE=50

# Minimum interval between syncs in milliseconds (default: 300000 = 5 minutes)
MKT_SYNC_MIN_INTERVAL_MS=300000

# Max retry attempts for failed sync items (default: 3)
MKT_SYNC_MAX_RETRIES=3

# Enable parallel batch processing (default: true)
MKT_SYNC_PARALLEL=true

# Enable stale cache invalidation (default: false)
MKT_SYNC_INVALIDATE_STALE=false

# Enable scheduled sync via cron job (default: true)
MKT_SCHEDULED_SYNC_ENABLED=true

# Cron expression for scheduled sync (default: every 30 minutes)
# Common patterns:
#   '0 */30 * * * *' - Every 30 minutes
#   '0 0 * * * *'    - Every hour
#   '0 */15 * * * *' - Every 15 minutes
MKT_SCHEDULED_SYNC_CRON='0 */30 * * * *'

# ========== MKT Order Configuration ==========
MKT_ORDER_TAX_ENABLED=false
MKT_ORDER_TAX_PERCENTAGE=10

# ========== ALS Transaction Configuration ==========
TRANSACTION_ALS_ENABLED=true
TRANSACTION_DEFAULT_TIMEOUT_MS=30000

