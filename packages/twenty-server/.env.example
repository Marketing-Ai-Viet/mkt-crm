# ========== MKT Auth Client Configuration ==========
# MKT Server authentication for Better Auth (Bearer token, no refresh)

# Required: MKT Server base URL
MKT_SERVER_BASE_URL=https://api.mkt-server.example.com

# Required: Authentication credentials
MKT_AUTH_EMAIL=service@example.com
MKT_AUTH_PASSWORD=your-secure-password

# Token configuration
# MKT_AUTH_TOKEN_SERVER_TTL_MS=86400000      # Server-side token TTL (default: 24h)
# MKT_AUTH_TOKEN_BUFFER_MS=3600000            # Buffer before expiry (default: 1h)

# Cache configuration
# MKT_AUTH_CACHE_LOCAL_TTL_MS=3600000         # Local cache TTL (default: 1h)

# Retry configuration
# MKT_AUTH_RETRY_MAX_ATTEMPTS=3               # Max retry attempts (default: 3)
# MKT_AUTH_RETRY_INITIAL_DELAY_MS=1000        # Initial delay (default: 1s)
# MKT_AUTH_RETRY_MAX_DELAY_MS=30000           # Max delay (default: 30s)
# MKT_AUTH_RETRY_BACKOFF_MULTIPLIER=2         # Backoff multiplier (default: 2)
# MKT_AUTH_RETRY_STATUS_CODES=429,500,502,503,504  # Retryable status codes

# Jitter configuration (reduces thundering herd)
# MKT_AUTH_JITTER_ENABLED=true                # Enable jitter (default: true)
# MKT_AUTH_JITTER_MIN_MS=30000                # Min jitter (default: 30s)
# MKT_AUTH_JITTER_MAX_MS=60000                # Max jitter (default: 60s)

# Circuit breaker configuration
# MKT_AUTH_CIRCUIT_BREAKER_ENABLED=true       # Enable circuit breaker (default: true)
# MKT_AUTH_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5  # Failures to open (default: 5)
# MKT_AUTH_CIRCUIT_BREAKER_RESET_TIMEOUT_MS=60000  # Time to stay open (default: 60s)
# MKT_AUTH_CIRCUIT_BREAKER_HALF_OPEN_MAX_ATTEMPTS=3  # Half-open attempts (default: 3)

# Lock configuration
# MKT_AUTH_LOCK_TIMEOUT_MS=30000              # Lock timeout (default: 30s)
# MKT_AUTH_LOCK_MAX_WAIT_MS=10000             # Max wait for lock (default: 10s)
# MKT_AUTH_LOCK_RETRY_INTERVAL_MS=100         # Lock retry interval (default: 100ms)

# Optional - default 5000 (5 seconds)
MKT_AUTH_TOKEN_SAFETY_MARGIN_MS=5000

# HTTP configuration
# MKT_AUTH_REJECT_UNAUTHORIZED=true           # Reject self-signed SSL certs (default: true)
                                              # Set to 'false' in development for self-signed certs

